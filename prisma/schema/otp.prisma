model OTP {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  verifiedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}