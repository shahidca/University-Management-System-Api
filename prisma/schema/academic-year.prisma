model AcademicYear {
  id        String     @id @default(uuid())
  name      String     @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  semesters Semester[]

  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
}
