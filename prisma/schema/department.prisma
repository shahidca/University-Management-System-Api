model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  courses     Course[]
  programs    Program[]

  @@index([isActive])
  @@index([deletedAt])
}
