model Fee {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  amount      Decimal   @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoiceItems InvoiceItem[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
}
